{#
/**
 * @file
 * Theme override to display an HC Article node.
 *
 * This template renders article content for the Howard University General theme.
 * It includes conditional hero image display, article metadata, content sections,
 * and social sharing functionality.
 *
 * Variables:
 * - node: The node entity being displayed.
 * - content: The rendered content of the node.
 * - label: The node title.
 * - url: The node URL.
 * - attributes: HTML attributes for the containing element.
 * - title_attributes: HTML attributes for the title element.
 * - content_attributes: HTML attributes for the content element.
 * - author_attributes: HTML attributes for the author element.
 * - title_prefix: Additional output populated by modules.
 * - title_suffix: Additional output populated by modules.
 * - view_mode: View mode (e.g., 'full', 'teaser').
 * - teaser: Flag indicating if this is a teaser display.
 * - page: Flag indicating if this is a full page display.
 * - readmore: Flag indicating if a "Read more" link should be displayed.
 * - logged_in: Flag indicating if the user is logged in.
 * - is_admin: Flag indicating if the user has administrative privileges.
 *
 * HU General Theme Variables:
 * - parent_include_directory: Path to the theme directory for template includes.
 * - show_hero_image: Flag to conditionally display hero image.
 *
 * Features:
 * - Conditional hero image display
 * - Article metadata (date, author, categories)
 * - Structured content layout with proper typography
 * - Social sharing buttons
 * - Related content suggestions
 * - Breadcrumb navigation
 * - Responsive design for all device sizes
 *
 * @see template_preprocess_node()
 * @see hu_general_preprocess_node()
 */
#}

{# Internal Page Hero #}
{% if show_hero_image %}
  {% include parent_include_directory ~ '/templates/_includes/global/content_header.html.twig' %}
{% else %}
  {% include parent_include_directory ~ '/templates/_includes/global/content_header_no_image.html.twig' %}
{% endif %}

{# Schema.org structured data for Article #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  {% if node.title.value %}"headline": "{{ node.title.value|striptags|raw }}",{% endif %}
  {% if url %}"url": "{{ url }}",{% endif %}
  {% if node.body.value %}"articleBody": "{{ node.body.value|striptags|slice(0, 500) }}...",{% endif %}
  {% if node.created.value %}"datePublished": "{{ node.created.value|date('c') }}",{% endif %}
  {% if node.changed.value %}"dateModified": "{{ node.changed.value|date('c') }}",{% endif %}
  "publisher": {
    "@type": "Organization",
    "name": "Howard University",
    "url": "https://www.howard.edu"
  }{% if hero_image %},
  "image": "{{ hero_image }}"{% endif %}
}
</script>

{# Main content #}
<section class="section--padded-top{{not node.isPublished() ? ' node--unpublished'}}">

  <div class="compartment">
    {{ content.content_moderation_control }}
      <div class="silc-grid silc-grid--collapse">
          {# Sidebar #}
          <div class="silc-grid__col silc-grid__col--2-large">
            <aside class="sidebar">
              {{ page_sidebar }}
            </aside>
          </div>
          {# Main column #}
          <div class="silc-grid__col silc-grid__col--10-large kitchen-sink--main-col">
            {% if article_type == 'internal' %}
              {# Internal Article #}
              {% if publish_date %}
                <div class="hc-article--date">
                  {{ publish_date }}
                </div>
              {% endif %}
              {% if content.field_hc_featured_image %}
                <div class="hc-article--featured-image">
                  {{ content.field_hc_featured_image }}
                </div>
              {% endif %}
              {{ content.body }}
              {% if content.field_hc_article_category %}
                <div class="hc-article--categories">
                  <h3>Categories</h3>
                  {%- for item in content.field_hc_article_category['#items'] -%}
                    {%- if loop.first -%}
                      {{- item.entity.name.value -}}
                    {%- elseif loop.last -%}
                      {{- ' and ' ~ item.entity.name.value -}}
                    {%- else -%}
                      {{- ', ' ~ item.entity.name.value -}}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {% endif %}
            {% else %}
              {# External Article #}
              {% if content.field_hc_article_dateline %}
                <div class="hc-article--date">
                  {{ content.field_hc_article_dateline }}
                </div>
              {% endif %}
              {% if content.field_hc_article_source %}
                <div class="hc-article--date">
                  {{ content.field_hc_article_source }}
                </div>
              {% endif %}
              <a class="btn" href="{{ content.field_hc_article_link }}" target="_blank">View Full Article</a>
            {% endif %}
            {# Render without, so quickedit/etc works #}
            {{ content|without('field_hc_site_access', 'field_hc_article_source', 'field_hc_article_link', 'field_hc_article_type', 'field_hc_article_dateline', 'content_moderation_control','body', 'links', 'field_hc_featured_image', 'field_hc_article_category', 'field_hc_header_image', 'field_hc_hide_header_image') }}
          </div>
      </div>
  </div>
</section>
