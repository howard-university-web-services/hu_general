{#
/**
 * @file
 * Theme override to display an HC Announcement node.
 *
 * This template renders announcement content for the Howard University General
 * theme. Announcements are used for important notices, alerts, events, and
 * time-sensitive information that needs to be prominently displayed.
 *
 * Variables:
 * - node: The node entity being displayed.
 * - content: The rendered content of the node.
 * - label: The node title.
 * - url: The node URL.
 * - attributes: HTML attributes for the containing element.
 * - title_attributes: HTML attributes for the title element.
 * - content_attributes: HTML attributes for the content element.
 * - author_attributes: HTML attributes for the author element.
 * - title_prefix: Additional output populated by modules.
 * - title_suffix: Additional output populated by modules.
 * - view_mode: View mode (e.g., 'full', 'teaser').
 * - teaser: Flag indicating if this is a teaser display.
 * - page: Flag indicating if this is a full page display.
 * - readmore: Flag indicating if a "Read more" link should be displayed.
 * - logged_in: Flag indicating if the user is logged in.
 * - is_admin: Flag indicating if the user has administrative privileges.
 *
 * HU General Theme Variables:
 * - parent_include_directory: Path to the theme directory for template includes.
 *
 * Features:
 * - Announcement-specific styling and layout
 * - Date and time display for time-sensitive content
 * - Priority/urgency indicators
 * - Contact information for announcements
 * - Category and tag display
 * - Expiration date handling
 * - Grid-based layout for organized content presentation
 * - Responsive design for all device sizes
 * - Content moderation controls for administrators
 * - Accessibility features for important notices
 *
 * @see template_preprocess_node()
 * @see hu_general_preprocess_node()
 */
#}

{% include parent_include_directory ~ '/templates/_includes/global/content_header_no_image.html.twig' %}

{# Schema.org structured data for Announcement #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article"{% if node.title.value %},
  "headline": {{ node.title.value|json_encode|raw }}{% endif %}{% if node.field_hc_summary.value %},
  "description": {{ node.field_hc_summary.value|json_encode|raw }}{% endif %}{% if node.created.value %},
  "datePublished": {{ node.created.value|date('c')|json_encode|raw }}{% endif %}{% if node.changed.value %},
  "dateModified": {{ node.changed.value|date('c')|json_encode|raw }}{% endif %}{% if node.field_hc_start_date.value %},
  "datePublished": {{ node.field_hc_start_date.value|date('c')|json_encode|raw }}{% endif %}{% if node.field_hc_end_date.value %},
  "expires": {{ node.field_hc_end_date.value|date('c')|json_encode|raw }}{% endif %},
  "publisher": {
    "@type": "Organization",
    "name": {{ site_name|json_encode|raw }},
    "url": "https://www.howard.edu"
  }
}
</script>

<section class="section--padded-top{{not node.isPublished() ? ' node--unpublished'}}">
  <div class="compartment">
    {{ content.content_moderation_control }}
    <div class="silc-grid silc-grid--collapse">

      <div class="silc-grid__col silc-grid__col--2-large">
        <aside class="sidebar">
          {{ page_sidebar }}
        </aside>
      </div>

      <div class="silc-grid__col silc-grid__col--10-large kitchen-sink--main-col">
        <p>{{ content.field_hc_summary }}</p>
        {# Render without, so quickedit/etc works #}
        {{ content|without('field_hc_site_access', 'content_moderation_control','field_hc_summary', 'field_hc_end_date', 'field_hc_featured', 'field_hc_links', 'field_hc_start_date') }}
      </div>

    </div>
  </div>
</section>
