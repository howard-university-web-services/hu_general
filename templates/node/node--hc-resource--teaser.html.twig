{#
/**
 * @file
 * Theme override to display an HC Resource node teaser.
 *
 * This template renders resource content in teaser format for the Howard University
 * General theme. It's used in resource listings, search results, and other contexts
 * where a condensed resource representation is needed.
 *
 * Variables:
 * - node: The node entity being displayed.
 * - content: The rendered content of the node.
 * - label: The node title.
 * - url: The node URL.
 * - attributes: HTML attributes for the containing element.
 * - title_attributes: HTML attributes for the title element.
 * - content_attributes: HTML attributes for the content element.
 * - view_mode: View mode (always 'teaser' for this template).
 * - teaser: Flag indicating this is a teaser display (always true).
 * - page: Flag indicating if this is a full page display (always false).
 * - readmore: Flag indicating if a "Read more" link should be displayed.
 * - logged_in: Flag indicating if the user is logged in.
 * - is_admin: Flag indicating if the user has administrative privileges.
 *
 * Features:
 * - Resource title and description
 * - Resource type indicator
 * - Brief summary or excerpt
 * - File format and size information
 * - Link to full resource page
 * - Download links (if applicable)
 * - Responsive grid layout
 * - Content moderation controls for administrators
 *
 * @see template_preprocess_node()
 * @see hu_general_preprocess_node()
 */
#}

{# Schema.org structured data for Resource Teaser #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  {% if node.title.value %}"headline": "{{ node.title.value|striptags|raw }}",{% endif %}
  {% if url %}"url": "{{ url }}",{% endif %}
  "publisher": {
    "@type": "Organization",
    "name": "Howard University",
    "url": "https://www.howard.edu"
  }
}
</script>

<section class="section--padded-top{{not node.isPublished() ? ' node--unpublished'}}">
  <div class="compartment">
    {{ content.content_moderation_control }}
    <div class="silc-grid silc-grid--collapse">
      <div class="silc-grid__col silc-grid__col--12-large kitchen-sink--main-col">
        <h3 class="news-and-events__title header--h3-small">{{node.title.value}}</h3>
        <div class="body-text--small">{{ content.body }}</div>
        <a href="{{ url }}" class="fancy-link">
          <span>Read More
            <span class="visually-hidden">
                about
                {{ node.title.value }}
            </span>
          </span>
          <span class="icon-arrow-right"></span>
        </a>
        {# Render without, so quickedit/etc works #}
        {{ content|without('content_moderation_control','field_hc_resource_sidebar_title', 'field_hc_resource_contact_name', 'field_hc_resource_contact_email', 'field_hc_resource_contact_addres', 'body', 'field_hc_resource_category', 'field_hc_header_image', 'field_hc_resource_cta_link', 'field_hc_resource_documents', 'field_hc_lead_in') }}
      </div>
    </div>
  </div>
</section>
