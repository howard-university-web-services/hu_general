{#
/**
 * @file
 * Theme override to display an HC Article node teaser.
 *
 * This template renders article content in teaser format for the Howard University
 * General theme. It's used in lists, views, and other contexts where a condensed
 * article representation is needed.
 *
 * Variables:
 * - node: The node entity being displayed.
 * - content: The rendered content of the node.
 * - label: The node title.
 * - url: The node URL.
 * - attributes: HTML attributes for the containing element.
 * - title_attributes: HTML attributes for the title element.
 * - content_attributes: HTML attributes for the content element.
 * - view_mode: View mode (always 'teaser' for this template).
 * - teaser: Flag indicating this is a teaser display (always true).
 * - page: Flag indicating if this is a full page display (always false).
 * - readmore: Flag indicating if a "Read more" link should be displayed.
 * - logged_in: Flag indicating if the user is logged in.
 * - is_admin: Flag indicating if the user has administrative privileges.
 *
 * Features:
 * - Condensed article information
 * - Article type handling (internal vs. external)
 * - Thumbnail image display
 * - Excerpt or summary text
 * - Publication date and metadata
 * - "Read more" link for full article
 * - Responsive grid layout
 * - Content moderation controls for administrators
 *
 * @see template_preprocess_node()
 * @see hu_general_preprocess_node()
 */
#}

{# Schema.org structured data for Article Teaser #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  {% if label %}"headline": "{{ label|striptags }}",{% endif %}
  {% if url %}"url": "{{ url }}",{% endif %}
  "publisher": {
    "@type": "Organization",
    "name": "Howard University",
    "url": "https://www.howard.edu"
  }
}
</script>

<section class="section--padded-top">
	<div class="compartment">
		{{ content.content_moderation_control }}
		<div class="silc-grid silc-grid--collapse{{not node.isPublished() ? ' node--unpublished'}}">
			<div class="silc-grid__col silc-grid__col--12-large kitchen-sink--main-col">
				<h3 class="news-and-events__title header--h3-small">{{ node.title.value }}</h3>
				{% if node.field_hc_article_type.0.value == 'internal' %}
					{# Internal Article #}
					<p class="body-text--small">{{ content.body }}</p>
					<a href="{{ url }}" class="fancy-link">
						<span>Read More
							<span class="visually-hidden">
								about
								{{ node.title.value }}
							</span>
						</span>
						<span class="icon-arrow-right"></span>
					</a>
				{% else %}
					{# External Article #}
					{% if content.field_hc_article_dateline or content.field_hc_article_source %}
						<p>
							{% if content.field_hc_article_dateline %}
								{{ content.field_hc_article_dateline }}
							{% endif %}
							{% if content.field_hc_article_source %}
								|
								{{ content.field_hc_article_source }}
							{% endif %}
						</p>
					{% endif %}
					<a href="{{ content.field_hc_article_link }}" class="fancy-link" target="_blank">
						<span>Read More
							<span class="visually-hidden">
								about
								{{ node.title.value }}
							</span>
						</span>
						<span class="icon-arrow-right"></span>
					</a>
				{% endif %}
				{# Render without, so quickedit/etc works #}
				{{ content|without('field_hc_article_source', 'field_hc_article_link', 'field_hc_article_type', 'field_hc_article_dateline', 'content_moderation_control','body', 'links', 'field_hc_featured_image', 'field_hc_article_category', 'field_hc_header_image', 'field_hc_hide_header_image') }}
			</div>
		</div>
	</div>
</section>
