{#
/**
 * @file
 * Theme override to display an HC Person node.
 *
 * This template renders person/faculty profile content for the Howard University
 * General theme. It includes profile information, contact details, biography,
 * and other relevant person-specific content.
 *
 * Variables:
 * - node: The node entity being displayed.
 * - content: The rendered content of the node.
 * - label: The node title (person's name).
 * - url: The node URL.
 * - attributes: HTML attributes for the containing element.
 * - title_attributes: HTML attributes for the title element.
 * - content_attributes: HTML attributes for the content element.
 * - author_attributes: HTML attributes for the author element.
 * - title_prefix: Additional output populated by modules.
 * - title_suffix: Additional output populated by modules.
 * - view_mode: View mode (e.g., 'full', 'teaser').
 * - teaser: Flag indicating if this is a teaser display.
 * - page: Flag indicating if this is a full page display.
 * - readmore: Flag indicating if a "Read more" link should be displayed.
 * - logged_in: Flag indicating if the user is logged in.
 * - is_admin: Flag indicating if the user has administrative privileges.
 *
 * HU General Theme Variables:
 * - parent_include_directory: Path to the theme directory for template includes.
 *
 * Features:
 * - Profile photo display
 * - Contact information (email, phone, office location)
 * - Biography and professional information
 * - Educational background
 * - Publications and research interests
 * - Grid-based layout for organized content presentation
 * - Responsive design for all device sizes
 * - Content moderation controls for administrators
 *
 * @see template_preprocess_node()
 * @see hu_general_preprocess_node()
 */
#}

{# Internal Page Hero #}
{% include parent_include_directory ~ '/templates/_includes/global/content_header_no_image.html.twig' %}

{# Schema.org structured data for Person #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person"{% if node.getTitle() %},
  "name": {{ node.getTitle()|striptags|json_encode|raw }}{% endif %}{% if node.field_hc_person_title.value %},
  "jobTitle": {{ node.field_hc_person_title.value|striptags|json_encode|raw }}{% endif %}{% if node.field_hc_person_organization.value %},
  "worksFor": {
    "@type": "Organization",
    "name": {{ node.field_hc_person_organization.value|striptags|json_encode|raw }}
  }{% endif %}{% if node.body.value %},
  "description": {{ node.body.value|striptags|slice(0, 300)|json_encode|raw }}{% endif %}{% if node.field_hc_person_link.0.uri %},
  "url": {{ node.field_hc_person_link.0.uri|json_encode|raw }}{% endif %}{% if node.field_hc_person_image.entity %},
  "image": "{{ file_url(node.field_hc_person_image.entity.uri.value) }}"{% endif %}{% if node.field_hc_person_email.0.uri %},
  "email": {{ node.field_hc_person_email.0.uri|replace({'mailto:': ''})|json_encode|raw }}{% endif %}{% if node.field_hc_person_phone.value %},
  "telephone": {{ node.field_hc_person_phone.value|striptags|json_encode|raw }}{% endif %},
  "affiliation": {
    "@type": "EducationalOrganization",
    "name": "Howard University",
    "url": "https://www.howard.edu"
  }{% if url %},
  "mainEntityOfPage": "{{ url }}"{% endif %}
}
</script>

<section class="section--padded-top{{not node.isPublished() ? ' node--unpublished'}}">
  <div class="compartment">
    {{ content.content_moderation_control }}
      <div class="silc-grid silc-grid--collapse">
        <div class="silc-grid__col silc-grid__col--2-large">
          <aside class="sidebar">
            {{ page_sidebar }}
          </aside>
        </div>
        <div class="silc-grid__col silc-grid__col--10-large kitchen-sink--main-col">
          {# Main content #}
          <div class="hc_person-details">
            <div class="hc_person-details__image-meta">
              <div class="hc_person-details__image">
                {{ content.field_hc_person_image }}
              </div>
              <div class="hc_person-details__meta">
                {% if content.field_hc_person_link|render %}
                  <div class="hc_person-details__website">
                    {{ content.field_hc_person_link }}
                  </div>
                {% endif %}
              </div>
            </div>
            <div class="hc_person-details__content">
              <div class="hc_person-details__content-top">
                <h2 class="hc_person-details__name">{{ node.getTitle() }}</h2>
                {% if content.field_hc_person_title|render %}
                  <p class="hc_person-details__title">{{ content.field_hc_person_title }}</p>
                {% endif %}
                {% if content.field_hc_person_organization|render %}
                  <p class="hc_person-details__organization">{{ content.field_hc_person_organization }}</p>
                {% endif %}
              </div>
              <div class="hc_person-details__content-bottom">
                <div class="silc-grid">
                  {% if content.field_hc_person_category|render %}
                    <div class="silc-grid__col silc-grid__col--medium-s-6 hc_person-details__content-subsection">
                      <h3 class="h4 hc_person-details__content-subsection-title">Categories</h3>
                      <div class="hc_person-details__categories">
                        <ul>
                          {% for item in content.field_hc_person_category['#items'] %}
                            <li>{{ item.entity.name.value }}</li>
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
          <div class="section--padded-top section--padded-bottom">
            <h2>Biography</h2>
            {{ content.body }}
          </div>
        </div>
      </div>
  </div>
</section>

{# Render without, so quickedit/etc works #}
{{ content|without('field_hc_site_access', 'content_moderation_control','body', 'field_hc_person_image', 'field_hc_person_category', 'field_hc_last_name', 'field_hc_person_title', 'field_hc_person_link', 'field_hc_person_organization') }}

