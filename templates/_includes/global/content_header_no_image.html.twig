{#
/**
 * @file
 * Content header template without image for Howard University General theme.
 *
 * This template provides a clean content header section for pages that do not
 * include a hero image. It displays the page title and breadcrumbs with
 * simple, typography-focused styling.
 *
 * Available variables:
 * - node: The current node entity.
 * - breadcrumbs: The breadcrumb navigation.
 *
 * Features:
 * - Clean, minimalist header design
 * - Page title display with proper heading hierarchy
 * - Breadcrumb navigation integration
 * - Typography-focused design without image distractions
 * - Accessible markup with semantic header structure
 * - Responsive design for all device sizes
 * - Consistent styling with Howard University brand guidelines
 * - Fast loading without image dependencies
 * - SEO-friendly heading structure
 * - Professional appearance for text-heavy content
 *
 * @see hu_general_preprocess_page()
 * @see hu_general_preprocess_node()
 */
#}
<header class="post-header">
  <div class="compartment">
    {{ breadcrumbs }}
    <h1 class="post-header__title">{{node.title.value}}</h1>
  </div>
</header>
