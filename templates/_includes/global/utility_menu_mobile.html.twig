{#
/**
 * @file
 * Mobile utility menu template for Howard University General theme.
 *
 * This template provides the mobile-specific utility menu functionality,
 * optimized for touch interfaces and smaller screen sizes. It includes
 * condensed navigation and search functionality for mobile devices.
 *
 * Available variables:
 * - menu: The utility menu content.
 * - fid: Form ID for the search form.
 *
 * HU General Theme Variables:
 * - featured_header_link_show: Flag to show/hide featured header link.
 * - featured_header_link_url: URL for the featured header link.
 * - featured_header_link_title: Title text for the featured header link.
 * - featured_header_hide_search: Flag to show/hide search functionality.
 *
 * Features:
 * - Mobile-optimized utility navigation
 * - Touch-friendly interface elements
 * - Featured header link with mobile-specific styling
 * - Mobile search form with appropriate input types
 * - Responsive design optimized for small screens
 * - Accessible markup with mobile accessibility considerations
 * - Consistent styling with Howard University mobile brand guidelines
 * - Conditional display based on theme settings
 * - Optimized for one-handed mobile usage
 *
 * @see hu_general_preprocess_page()
 * @see _hu_general_extend_theme_variables()
 */
#}
<div class="utility">
	<div class="utility__menu">
		{% if featured_header_link_show %}
			<a class="utility__featured-link" href="{{ featured_header_link_url }}">{{ featured_header_link_title }}</a>
		{% endif %}
		{{ menu }}
	</div>
</div>

{% if not featured_header_hide_search %}
	<div class="utility__search-mobile">
		<form action="/search/node" class="utility__search-form-mobile" id="{{ fid }}" method="get">
			<label for="{{ fid }}-{{ sid }}" class="visible-for-screen-readers">Search this Site</label>
			<input type="text" class="utility__search__mobile-input" name="keys" id="{{ fid }}-{{ sid }}" placeholder="Search...">
			<button type="submit" class="utility__search__mobile-submit">go</button>
		</form>
	</div>
{% endif %}
