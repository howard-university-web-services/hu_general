{#
/**
 * @file
 * Global header template for Howard University General theme.
 *
 * This template provides the main header structure for all pages in the Howard
 * University General theme. It includes the university branding, navigation,
 * search functionality, and responsive mobile menu controls.
 *
 * Features:
 * - Howard University branding and logo
 * - Primary navigation menu
 * - Responsive mobile menu (hamburger menu)
 * - Search functionality
 * - Utility menu for secondary navigation
 * - Featured header link display
 * - Light/dark header theme variants
 * - Accessible markup with proper ARIA labels
 * - OpenID Connect login integration
 *
 * HU General Theme Variables:
 * - h_menu: Hamburger menu setting (1 = show, 0 = hide)
 * - light_header: Light header theme setting
 * - featured_header_link_show: Featured link display setting
 * - featured_header_link_title: Featured link title text
 * - featured_header_link_url: Featured link URL
 * - featured_header_hide_search: Search functionality display setting
 * - login_block: OpenID Connect login block (if available)
 * - parent_school_college: Parent organization name
 * - parent_school_college_link: Parent organization URL
 * - department: Department/site name
 *
 * @see hu_general_preprocess_page()
 */
#}
{% if h_menu == 1 %}
    {% set h_menu = 'show-menu-mobile' %}
    {% set c_menu = 'display-menu-mobile' %}
{% else %}
    {% set h_menu = 'no-display-menu-mobile' %}
    {% set c_menu = 'hidden-menu-mobile' %}
{% endif %}
<header class="main-header {% if light_header %}main-header--light{% endif %} {{ c_menu }}" aria-label="main-header">
    <div class="main-header__top">
        <div class="main-header__logo">
            <div class="main-header__logo-link">
                <a class="main-header__hu-logo" href="http://howard.edu">
                    <img src="{{ base_path ~ directory }}/idfive-component-library/build/img/site-logo-white3.svg" alt="Howard Logo">
                </a>
                {% if parent_school_college %}
                    <span class="main-header__title"><a href="{{ parent_school_college_link }}">{{ parent_school_college }}</a></span>
                {% endif %}
            </div>
        </div>
        <div class="main-header__utility">
            {% include parent_include_directory ~ '/templates/_includes/global/utility_menu.html.twig' with {'fid': 'mainSearch', 'sid': 'keyword', 'menu': page.secondary_menu} %}
        </div>
    </div>

    <div class="main-header__bottom">
        <h2 class="main-header__dept"><a href="{{front_page}}">{{ department }}</a></h2>
        <div class="main-header__nav-wrap">
            <div class="main-header__drawer">
                <div class="main-header__nav {{ h_menu }}">
                    {{ page.primary_menu }}
                </div>
                <div class="main-header__utility main-header__utility--mobile">
                    {% include parent_include_directory ~ '/templates/_includes/global/utility_menu_mobile.html.twig' with {'fid': 'mainSearchMobile', 'sid': 'keyword', 'menu': page.tertiary_menu} %}
                </div>
            </div>
        </div>
        <div class="main-header__trigger-menu {{ h_menu }}">
            <div class="bar1"></div>
            <div class="bar2"></div>
            <div class="bar3"></div>
        </div>
    </div>
</header>
