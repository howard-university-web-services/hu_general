{#
/**
 * @file
 * Global footer template for Howard University General theme.
 *
 * This template provides the main footer structure for all pages in the Howard
 * University General theme. It includes contact information, social media links,
 * footer navigation, and university-wide links.
 *
 * Features:
 * - Contact information and address display
 * - Social media links (Twitter, Facebook, YouTube, Instagram)
 * - Footer navigation menus (primary and secondary)
 * - University-wide links and resources
 * - Responsive design for all device sizes
 * - Accessible markup with proper semantic elements
 * - Consistent styling with Howard University brand guidelines
 * - Copyright and legal information
 *
 * HU General Theme Variables:
 * - address_line_one: First line of address
 * - address_line_two: Second line of address
 * - address_line_three: Third line of address
 * - phone: Phone number
 * - email: Email address
 * - twitter_link: Twitter profile URL
 * - facebook_link: Facebook profile URL
 * - youtube_link: YouTube profile URL
 * - instagram_link: Instagram profile URL
 * - parent_school_college: Parent organization name
 * - parent_school_college_link: Parent organization URL
 * - department: Department/site name
 *
 * @see hu_general_preprocess_page()
 * @see _hu_general_extend_theme_variables()
 */
#}
<footer class="main-footer" aria-label="Footer">
	<div class="main-footer__top">
		<div class="main-footer__contact">
			<address class="site__address">
				{% if address_line_one %}
					<strong class="main-footer__title">{{ address_line_one }}</strong><br>
				{% endif %}
				{% if address_line_two %}
					<span>{{ address_line_two }}</span><br>
				{% endif %}
				{% if address_line_three %}
					<span>{{ address_line_three }}</span><br>
				{% endif %}
				{% if phone %}
					<span>Phone:
						{{ phone }}</span>
				{% endif %}
				{% if email %}
					<span>Email:
						{{ email }}</span>
				{% endif %}

			</address>
		</div>
		<div class="main-footer__nav">

			<div class="main-footer__social">
				<ul class="social-links">
					{% if facebook_link %}
						<li>
							<a class="social-links__item" href="{{ facebook_link }}" target="_blank">
								<i class="icon-facebook">
									<span class="visible-for-screen-readers">Facebook</span>
								</i>
							</a>
						</li>
					{% endif %}
					{% if twitter_link %}
						<li>
							<a class="social-links__item" href="{{ twitter_link }}" target="_blank">
								<i class="icon-twitter">
									<span class="visible-for-screen-readers">Twitter</span>
								</i>
							</a>
						</li>
					{% endif %}
					{% if instagram_link %}
						<li>
							<a class="social-links__item" href="{{ instagram_link }}" target="_blank">
								<i class="icon-instagram">
									<span class="visible-for-screen-readers">Instagram</span>
								</i>
							</a>
						</li>
					{% endif %}
					{% if youtube_link %}
						<li>
							<a class="social-links__item" href="{{ youtube_link }}" target="_blank">
								<i class="icon-youtube">
									<span class="visible-for-screen-readers">Youtube</span>
								</i>
							</a>
						</li>
					{% endif %}
				</ul>
			</div>

			<div class="main-footer__menu">
				<nav class="main-footer__main-nav">
					{{ page.footer_primary_menu }}
				</nav>
			</div>

			<div>
				<nav class="main-footer__main-nav access">
					<ul>
						<li>
							<a href="https://howard.edu/accessibility-statement" title="Web Accessibility Support">Web Accessibility Support</a>
						</li>
						{# <li>
																			<a href="https://howard.edu/privacy" title="Privacy &amp; Security Notice">Privacy &amp; Security Notice</a>
																		</li>
																		<li>
																			<a href="https://howard.edu/terms" title="Terms &amp; Conditions of Use">Terms &amp; Conditions of Use</a>
																		</li> #}
					</ul>
				</nav>
			</div>

		</div>
	</div>
	<div class=" main-footer__bottom">

		<div class="silc-grid silc-grid--align-center-medium">

			<div class="silc-grid__col silc-grid__col--1-medium">
				<a href="http://howard.edu" class="main-footer__bottom-logo">
					<img src="{{ base_path ~ directory }}/idfive-component-library/build/img/howard_clocktower_logo_white_footer.svg" alt="Howard Logo COAS">
				</a>
			</div>

			<div class="silc-grid__col silc-grid__col--5-medium">
				<div class="main-footer__copyright">
					<span>&copy;
						{{ "now"|date("Y") }}
						Howard University. All Rights Reserved.</span>
				</div>
			</div>

			<div class="silc-grid__col silc-grid__col--6-medium">
				<div class="main-footer__bottom-nav">
					{{ page.footer_menu }}
				</div>
			</div>

		</div>

	</div>
	{% if logged_in and show_switcher %}
		<select class="theme-option-select"></select>
	{% endif %}
</footer>
