{#
/**
 * @file
 * Homepage content header with video for Howard University General theme.
 *
 * This template provides a homepage header section featuring a background video
 * with overlay text and interactive elements. It creates a dynamic, engaging
 * homepage experience with multimedia content.
 *
 * Available variables:
 * - content: The rendered content of the homepage node.
 * - node: The homepage node entity.
 *
 * HU General Theme Variables:
 * - hide_overlay: Flag to show/hide the blue overlay.
 * - hero_media_video: Vimeo video ID for the background video.
 *
 * Content Fields:
 * - field_hc_intro_video_text: Text overlay for the hero video.
 * - field_hc_intro_link: Call-to-action link.
 * - field_hc_intro_link_title: Link title text.
 * - field_hc_video_controls: Video playback controls settings.
 *
 * Features:
 * - Full-width background video (Vimeo integration)
 * - Optional blue overlay for brand consistency and text readability
 * - Overlay text with customizable content
 * - Call-to-action button integration
 * - Deferred video loading for performance
 * - Accessible video controls and ARIA labels
 * - Mobile-responsive fallback options
 * - Grid-based responsive layout
 * - SEO-friendly content structure
 * - High engagement multimedia experience
 * - Video playback optimization
 *
 * @see hu_general_preprocess_page()
 * @see hu_general_preprocess_node()
 */
#}
{# Homepage Hero (video) #}
<section class="hero-video section--blue-blend" aria-label="Howard University">
    {% if not hide_overlay %}
        <div class="blue-overlay--video-image"></div>
    {% endif %}
    {% if hero_media_video %}
        <div data-vimeo-id="{{ hero_media_video }}" data-vimeo-defer id="hcsh-hero-video"></div>
    {% endif %}
        <div class="compartment">
            <div class="silc-grid silc-grid--collapse">
                <div class="silc-grid__col silc-grid__col--8-medium">
                    {% if content.field_hc_intro_image_text|render %}
                        <h2 class="header--white header--page-intro">{{ content.field_hc_intro_image_text }}</h2>
                    {% endif %}
                    {% if content.field_hc_intro_image_links|render %}
                        <div class="header--page-links">
                            {% for key, item in content.field_hc_intro_image_links %}
                                {% if key|first != '#' %}
                                    <a href="{{ content.field_hc_intro_image_links[key]['#url'] }}" class="btn"{% if content.field_hc_intro_image_links[key]['#options'].attributes.target %} target="{{ content.field_hc_intro_image_links[key]['#options'].attributes.target }}"{% endif %}>
                                        <span class="btn__text">{{ content.field_hc_intro_image_links[key]['#title'] }}</span>
                                        <span class="icon-arrow-right"></span>
                                    </a>
                                {% endif %}
                            {% endfor %}
                        </div>
					 {% endif %}
                </div>
            </div>
        </div>
    <div class="hcsc_hero_video_controls">
        <div class="hcsc_hero_video_control hcsc_hero_video_pause_control">
            <div class="hcsc_hero_video_pause">
                <span class="visible-for-screen-readers">Pause</span>
            </div>
        </div>
        <div class="hcsc_hero_video_control hcsc_hero_video_play_control visually-hidden">
            <div class="hcsc_hero_video_play">
                <span class="visible-for-screen-readers">Play</span>
            </div>
        </div>
    </div>
</section>
