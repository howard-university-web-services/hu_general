{#
/**
 * @file
 * Theme override for a breadcrumb trail.
 *
 * This template provides custom breadcrumb navigation for the Howard University
 * General theme. It includes proper accessibility markup and responsive styling.
 *
 * Available variables:
 * - breadcrumb: Breadcrumb trail items, each containing:
 *   - text: The breadcrumb text.
 *   - url: The breadcrumb URL (if applicable).
 *   - attributes: HTML attributes for the breadcrumb item.
 *
 * Features:
 * - Accessible breadcrumb navigation with proper ARIA labels
 * - Responsive design that adapts to different screen sizes
 * - Consistent styling with Howard University brand guidelines
 * - Proper semantic markup using nav and ol elements
 * - Current page indication (last item without link)
 * - Breadcrumb separator styling
 *
 * @see template_preprocess_breadcrumb()
 */
#}

{% if breadcrumb %}
  <nav aria-label="breadcrumb" class="breadcrumb">
    <ol class="breadcrumb__items">
      {% for item in breadcrumb %}
        {% if loop.last %}
          <li class="breadcrumb__item breadcrumb__item--active">
        {% else %}
          <li class="breadcrumb__item">
        {% endif %}
        {% if item.url %}
          <a href="{{ item.url }}">
            {% if loop.index == (loop.length - 1) %}
              <span class="breadcrumb__back-to-parent">Back to </span>
            {% endif %}
            <span class="breadcrumb__item-text">{{ item.text }}</span>
          </a>
        {% else %}
          {{ item.text }}
        {% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}
