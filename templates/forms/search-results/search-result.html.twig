{#
/**
 * @file
 * Theme override for displaying a single search result.
 *
 * This template renders a single search result item in the Howard University
 * General theme. It provides consistent formatting for search results across
 * different content types and search contexts.
 *
 * This template renders a single search result. The list of results is
 * rendered using '#theme' => 'item_list', with suggestions of:
 * - item_list__search_results__(plugin_id)
 * - item_list__search_results
 *
 * Available variables:
 * - url: URL of the result.
 * - title: Title of the result.
 * - snippet: A small preview of the result. Does not apply to user searches.
 * - info: String of all the meta information ready for print. Does not apply
 *   to user searches.
 * - plugin_id: The machine-name of the search plugin being used.
 * - title_prefix: Additional output populated by modules.
 * - title_suffix: Additional output populated by modules.
 * - title_attributes: HTML attributes for the title.
 * - content_attributes: HTML attributes for the content.
 *
 * Features:
 * - Consistent search result formatting across content types
 * - Proper highlighting of search terms in results
 * - Accessible markup with proper headings and links
 * - Responsive design for all device sizes
 * - Clear separation of result metadata and content
 * - Support for different search plugins and contexts
 * - Consistent styling with Howard University brand guidelines
 * - Proper truncation and snippet display
 *
 * @see template_preprocess_search_result()
 */
#}

<section class="search_results--section">
  {{ title_prefix }}
  <h3>
    <a href="{{ url }}">{{ title }}</a>
  </h3>
  {{ title_suffix }}
  {% if snippet %}
    <p{{ content_attributes }}>{{ snippet }}</p>
  {% endif %}
</section>
