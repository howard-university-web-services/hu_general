<?php

/**
 * @file
 * HU General theme file.
 *
 * This file contains theme hooks and preprocessing functions for the
 * Howard University General theme. It handles template variable preprocessing,
 * theme suggestions, and custom functionality specific to the HU General theme.
 */

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\file\Entity\File;

/**
 * Implements hook_preprocess_html().
 *
 * Preprocesses variables for the html.html.twig template.
 * 
 * Adds theme variant and admin scripts settings to the HTML template variables.
 * These settings are configured in the theme settings form and control the
 * overall appearance and functionality of the theme.
 *
 * @param array $variables
 *   An associative array containing:
 *   - theme_variant: The selected theme variant setting
 *   - admin_scripts: Custom scripts/tracking codes set by administrators
 */
function hu_general_preprocess_html(&$variables) {
  $variables['theme_variant'] = theme_get_setting('theme_variant');
  $variables['admin_scripts'] = theme_get_setting('admin_scripts');
}

/**
 * Implements hook_preprocess_page().
 *
 * Preprocesses variables for the page.html.twig template.
 *
 * This function extends theme variables with custom settings, sets up a default
 * hero image, makes the theme path available, configures OpenID Connect login
 * block if available, and sets up the hamburger menu setting.
 *
 * @param array $variables
 *   An associative array containing:
 *   - hero_image: Path to the default hero image
 *   - parent_include_directory: Path to the theme directory
 *   - login_block: Rendered OpenID Connect login block (if module exists)
 *   - h_menu: Hamburger menu setting for desktop display
 */
function hu_general_preprocess_page(&$variables) {
  _hu_general_extend_theme_variables($variables);
  $variables['hero_image'] = '/themes/contrib/hu_general/idfive-component-library/build/img/graduates_talking.jpg';
  $variables['parent_include_directory'] = \Drupal::service('theme_handler')->getTheme('hu_general')->getPath();
  // Make Oauth login block available.
  if (\Drupal::moduleHandler()->moduleExists('openid_connect')) {
    $block_manager = \Drupal::service('plugin.manager.block');
    $config = [];
    $plugin_block = $block_manager->createInstance('openid_connect_login', $config);
    $render = $plugin_block->build();
    $variables['login_block'] = \Drupal::service('renderer')->render($render);
  }

  // Implements hamburguer menu.
  $variables['h_menu'] = theme_get_setting('hamburguer_desktop');

}

/**
 * Implements hook_preprocess_node().
 *
 * Preprocesses variables for node templates.
 *
 * This function makes the theme path available to node templates and
 * extracts the node ID for potential use in node-specific processing.
 *
 * @param array $variables
 *   An associative array containing:
 *   - parent_include_directory: Path to the theme directory
 *   - node: The node object being processed
 */
function hu_general_preprocess_node(&$variables) {
  $node = $variables['elements']['#node'];
  $node_id = $node->id();
  $variables['parent_include_directory'] = \Drupal::service('theme_handler')->getTheme('hu_general')->getPath();
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for page templates.
 *
 * Adds custom page template suggestions based on HTTP status codes.
 *
 * This function specifically handles 404 error pages by adding a 
 * 'page__404' template suggestion, allowing for custom 404 page styling.
 *
 * @param array $suggestions
 *   An array of theme suggestions for page templates.
 * @param array $variables
 *   An array of variables passed to the theme template.
 * @param string $hook
 *   The name of the template being rendered.
 */
function hu_general_theme_suggestions_page_alter(&$suggestions, $variables, $hook) {
  if (!is_null(Drupal::requestStack()->getCurrentRequest()->attributes->get('exception'))) {
    $status_code = Drupal::requestStack()->getCurrentRequest()->attributes->get('exception')->getStatusCode();
    switch ($status_code) {
      case 404:
        $suggestions[] = 'page__' . (string) $status_code;
        break;

      default:
        break;
    }
  }
}

/**
 * Implements hook_preprocess_file_link().
 *
 * Preprocesses variables for file link templates.
 *
 * This function customizes file link display by:
 * - Using media names as link text when available (except for regular node file fields)
 * - Falling back to the filename if no media name is available
 * - Generating absolute URLs for file links
 * - Adding proper cache contexts for URL generation
 *
 * @param array $variables
 *   An associative array containing:
 *   - file: The file entity being processed
 *   - link_text: The text to display for the file link
 *   - link_url: The absolute URL to the file
 */
function hu_general_preprocess_file_link(&$variables) {
  $file = $variables['file'];
  $options = [];
  $file_entity = $file instanceof File ? $file : File::load($file->fid);
  $url = \Drupal::service('file_url_generator')->generateAbsoluteString($file_entity->getFileUri());
  $variables['#cache']['contexts'][] = 'url.site';
  if ($file_entity->_referringItem !== NULL) {
    $fieldParent = $file_entity->_referringItem->getEntity();
    $fieldParentType = $fieldParent->getEntityTypeId();
  }
  // Use the media name as the link text if available. Ignore if parent is a node, ie a regular file field.
  if (isset($fieldParent) && $fieldParentType !== 'node') {
    $link_text = $fieldParent->getName();
  }
  else {
    $link_text = $file_entity->getFilename();
  }
  $variables['link_text'] = $link_text;
  $variables['link_url'] = $url;
}

// CUSTOM FUNCTIONS.

/**
 * Make all theme settings available to insert in pages.
 *
 * This helper function extends template variables with all theme settings
 * configured in the theme settings form. It also handles proper caching
 * by adding the theme settings as a cache dependency.
 *
 * @param array $variables
 *   An associative array of template variables to extend with theme settings.
 */
function _hu_general_extend_theme_variables(&$variables) {
  $theme_name = \Drupal::theme()->getActiveTheme()->getName();
  $theme_settings = \Drupal::config($theme_name . '.settings');
  CacheableMetadata::createFromRenderArray($variables)
    ->addCacheableDependency($theme_settings)
    ->applyTo($variables);
  $variables += $theme_settings->getOriginal();
}
